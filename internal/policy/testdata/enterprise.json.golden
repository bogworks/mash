{
  "owner": "acme",
  "default": "deny",
  "covers": [
    "mail"
  ],
  "open": [
    "prompt",
    "status"
  ],
  "endpoints": [
    {
      "name": "billing-agent",
      "labels": {
        "net": "internal",
        "team": "finance"
      },
      "recipients": [
        "billing-agent",
        "build-bot",
        "deploy-tool",
        "ledger-agent",
        "support-bot"
      ],
      "may_mail_nobody": false
    },
    {
      "name": "build-bot",
      "labels": {
        "net": "internal",
        "team": "platform"
      },
      "recipients": [
        "billing-agent",
        "build-bot",
        "deploy-tool",
        "ledger-agent",
        "support-bot"
      ],
      "may_mail_nobody": false
    },
    {
      "name": "deploy-tool",
      "labels": {
        "kind": "tool",
        "net": "internal",
        "team": "platform"
      },
      "recipients": [
        "billing-agent",
        "build-bot",
        "deploy-tool",
        "ledger-agent",
        "support-bot"
      ],
      "may_mail_nobody": false
    },
    {
      "name": "hr-agent",
      "labels": {
        "net": "internal",
        "team": "hr"
      },
      "recipients": [
        "billing-agent",
        "build-bot",
        "deploy-tool",
        "ledger-agent",
        "support-bot"
      ],
      "may_mail_nobody": false
    },
    {
      "name": "ledger-agent",
      "labels": {
        "net": "internal",
        "team": "finance"
      },
      "recipients": [
        "billing-agent",
        "build-bot",
        "deploy-tool",
        "ledger-agent",
        "support-bot"
      ],
      "may_mail_nobody": false
    },
    {
      "name": "support-bot",
      "labels": {
        "net": "internal",
        "team": "support"
      },
      "recipients": [
        "billing-agent",
        "build-bot",
        "deploy-tool",
        "ledger-agent",
        "support-bot",
        "web-intake"
      ],
      "may_mail_nobody": false
    },
    {
      "name": "web-intake",
      "labels": {
        "internet": "yes",
        "net": "dmz",
        "team": "web"
      },
      "recipients": [
        "support-bot"
      ],
      "may_mail_nobody": false
    }
  ]
}
