{
  "owner": "acme",
  "default": "deny",
  "subject_label": "zone",
  "covers": [
    "mail"
  ],
  "open": [
    "prompt",
    "status"
  ],
  "zones": [
    {
      "name": "dmz",
      "wildcards": [],
      "endpoints": [
        "web-intake"
      ]
    },
    {
      "name": "internal",
      "wildcards": [
        "internal"
      ],
      "endpoints": [
        "billing-agent",
        "build-bot",
        "deploy-tool",
        "hr-agent",
        "ledger-agent",
        "support-bot"
      ]
    }
  ],
  "endpoints": [
    {
      "name": "billing-agent",
      "zone": "internal",
      "labels": {
        "team": "finance",
        "zone": "internal"
      },
      "recipients": [
        "billing-agent",
        "build-bot",
        "deploy-tool",
        "ledger-agent",
        "support-bot"
      ],
      "may_mail_nobody": false,
      "tags": [
        "deny:_none",
        "deny:internal.hr-agent"
      ]
    },
    {
      "name": "build-bot",
      "zone": "internal",
      "labels": {
        "team": "platform",
        "zone": "internal"
      },
      "recipients": [
        "billing-agent",
        "build-bot",
        "deploy-tool",
        "ledger-agent",
        "support-bot"
      ],
      "may_mail_nobody": false,
      "tags": [
        "deny:_none",
        "deny:internal.hr-agent"
      ]
    },
    {
      "name": "deploy-tool",
      "zone": "internal",
      "labels": {
        "kind": "tool",
        "team": "platform",
        "zone": "internal"
      },
      "recipients": [
        "billing-agent",
        "build-bot",
        "deploy-tool",
        "ledger-agent",
        "support-bot"
      ],
      "may_mail_nobody": false,
      "tags": [
        "deny:_none",
        "deny:internal.hr-agent"
      ]
    },
    {
      "name": "hr-agent",
      "zone": "internal",
      "labels": {
        "team": "hr",
        "zone": "internal"
      },
      "recipients": [
        "billing-agent",
        "build-bot",
        "deploy-tool",
        "ledger-agent",
        "support-bot"
      ],
      "may_mail_nobody": false,
      "tags": [
        "deny:_none",
        "deny:internal.hr-agent"
      ]
    },
    {
      "name": "ledger-agent",
      "zone": "internal",
      "labels": {
        "team": "finance",
        "zone": "internal"
      },
      "recipients": [
        "billing-agent",
        "build-bot",
        "deploy-tool",
        "ledger-agent",
        "support-bot"
      ],
      "may_mail_nobody": false,
      "tags": [
        "deny:_none",
        "deny:internal.hr-agent"
      ]
    },
    {
      "name": "support-bot",
      "zone": "internal",
      "labels": {
        "team": "support",
        "zone": "internal"
      },
      "recipients": [
        "billing-agent",
        "build-bot",
        "deploy-tool",
        "ledger-agent",
        "support-bot",
        "web-intake"
      ],
      "may_mail_nobody": false,
      "tags": [
        "allow:dmz.web-intake",
        "deny:_none",
        "deny:internal.hr-agent"
      ]
    },
    {
      "name": "web-intake",
      "zone": "dmz",
      "labels": {
        "internet": "yes",
        "team": "web",
        "zone": "dmz"
      },
      "recipients": [
        "support-bot"
      ],
      "may_mail_nobody": false,
      "tags": [
        "allow:internal.support-bot",
        "deny:_none"
      ]
    }
  ]
}
