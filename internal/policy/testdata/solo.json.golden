{
  "owner": "acme",
  "default": "allow",
  "subject_label": "zone",
  "covers": [
    "mail"
  ],
  "open": [
    "prompt",
    "status"
  ],
  "zones": [
    {
      "name": "default",
      "wildcards": [
        "default"
      ],
      "endpoints": [
        "coder",
        "deploy-bot",
        "reviewer"
      ]
    }
  ],
  "endpoints": [
    {
      "name": "coder",
      "zone": "default",
      "labels": {
        "role": "agent"
      },
      "recipients": [
        "coder",
        "reviewer"
      ],
      "may_mail_nobody": false,
      "tags": [
        "deny:_none",
        "deny:default.deploy-bot"
      ]
    },
    {
      "name": "deploy-bot",
      "zone": "default",
      "labels": {
        "kind": "tool",
        "risk": "high"
      },
      "recipients": [
        "coder",
        "deploy-bot",
        "reviewer"
      ],
      "may_mail_nobody": false,
      "tags": [
        "deny:_none"
      ]
    },
    {
      "name": "reviewer",
      "zone": "default",
      "labels": {
        "role": "agent"
      },
      "recipients": [
        "coder",
        "reviewer"
      ],
      "may_mail_nobody": false,
      "tags": [
        "deny:_none",
        "deny:default.deploy-bot"
      ]
    }
  ]
}
