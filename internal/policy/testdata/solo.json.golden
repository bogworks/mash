{
  "owner": "acme",
  "default": "allow",
  "covers": [
    "mail"
  ],
  "open": [
    "prompt",
    "status"
  ],
  "endpoints": [
    {
      "name": "coder",
      "labels": {
        "role": "agent"
      },
      "recipients": [
        "coder",
        "reviewer"
      ],
      "may_mail_nobody": false
    },
    {
      "name": "deploy-bot",
      "labels": {
        "kind": "tool",
        "risk": "high"
      },
      "recipients": [
        "coder",
        "deploy-bot",
        "reviewer"
      ],
      "may_mail_nobody": false
    },
    {
      "name": "reviewer",
      "labels": {
        "role": "agent"
      },
      "recipients": [
        "coder",
        "reviewer"
      ],
      "may_mail_nobody": false
    }
  ]
}
