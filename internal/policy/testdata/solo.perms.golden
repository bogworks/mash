{
  "zones": {
    "default": {
      "wildcards": [
        "default"
      ],
      "endpoints": [
        "coder",
        "deploy-bot",
        "reviewer"
      ],
      "template": {
        "pub": [
          "$JS.ACK.inbox-{{name()}}.deliver.\u003e",
          "$JS.API.CONSUMER.INFO.inbox-{{name()}}.deliver",
          "$JS.API.CONSUMER.MSG.NEXT.inbox-{{name()}}.deliver",
          "$JS.API.DIRECT.GET.KV_mash-directory.\u003e",
          "$JS.API.DIRECT.GET.KV_mash-leases.$KV.mash-leases.{{name()}}",
          "$JS.API.DIRECT.GET.inbox-{{name()}}",
          "$JS.API.DIRECT.GET.inbox-{{name()}}.\u003e",
          "$JS.API.INFO",
          "$JS.API.STREAM.INFO.KV_mash-directory",
          "$JS.API.STREAM.INFO.KV_mash-leases",
          "$JS.API.STREAM.INFO.inbox-{{name()}}",
          "$KV.mash-leases.{{name()}}",
          "$SRV.\u003e",
          "_INBOX.\u003e",
          "agents.hb.cc.acme.{{name()}}",
          "agents.mail.*.acme.default.*",
          "agents.mail.*.acme.{{tag(allow)}}",
          "agents.prompt.*.acme.default.*",
          "agents.prompt.*.acme.{{tag(allow)}}",
          "agents.status.*.acme.default.*",
          "agents.status.*.acme.{{tag(allow)}}"
        ],
        "pub_deny": [
          "agents.mail.*.acme.{{tag(deny)}}",
          "agents.prompt.*.acme.{{tag(deny)}}",
          "agents.status.*.acme.{{tag(deny)}}"
        ],
        "sub": [
          "$SRV.\u003e",
          "_INBOX.{{name()}}.\u003e",
          "agents.hb.*.acme.*",
          "agents.prompt.cc.acme.default.{{name()}}",
          "agents.status.cc.acme.default.{{name()}}"
        ]
      }
    }
  },
  "tags": {
    "coder": [
      "deny:default.deploy-bot"
    ],
    "deploy-bot": [
      "deny:0"
    ],
    "reviewer": [
      "deny:default.deploy-bot"
    ]
  }
}
