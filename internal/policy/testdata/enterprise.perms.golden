{
  "zones": {
    "dmz": {
      "wildcards": [],
      "endpoints": [
        "web-intake"
      ],
      "template": {
        "pub": [
          "$JS.ACK.inbox-{{name()}}.deliver.\u003e",
          "$JS.API.CONSUMER.INFO.inbox-{{name()}}.deliver",
          "$JS.API.CONSUMER.MSG.NEXT.inbox-{{name()}}.deliver",
          "$JS.API.DIRECT.GET.KV_mash-directory.\u003e",
          "$JS.API.DIRECT.GET.KV_mash-leases.$KV.mash-leases.{{name()}}",
          "$JS.API.DIRECT.GET.inbox-{{name()}}",
          "$JS.API.DIRECT.GET.inbox-{{name()}}.\u003e",
          "$JS.API.INFO",
          "$JS.API.STREAM.INFO.KV_mash-directory",
          "$JS.API.STREAM.INFO.KV_mash-leases",
          "$JS.API.STREAM.INFO.inbox-{{name()}}",
          "$KV.mash-leases.{{name()}}",
          "$SRV.\u003e",
          "_INBOX.\u003e",
          "agents.hb.cc.acme.{{name()}}",
          "agents.mail.*.acme.{{tag(allow)}}",
          "agents.prompt.*.acme.*",
          "agents.status.*.acme.*"
        ],
        "pub_deny": [
          "agents.mail.*.acme.{{tag(deny)}}"
        ],
        "sub": [
          "$SRV.\u003e",
          "_INBOX.{{name()}}.\u003e",
          "agents.hb.*.acme.*",
          "agents.prompt.cc.acme.{{name()}}",
          "agents.status.cc.acme.{{name()}}"
        ]
      }
    },
    "internal": {
      "wildcards": [
        "internal"
      ],
      "endpoints": [
        "billing-agent",
        "build-bot",
        "deploy-tool",
        "hr-agent",
        "ledger-agent",
        "support-bot"
      ],
      "template": {
        "pub": [
          "$JS.ACK.inbox-{{name()}}.deliver.\u003e",
          "$JS.API.CONSUMER.INFO.inbox-{{name()}}.deliver",
          "$JS.API.CONSUMER.MSG.NEXT.inbox-{{name()}}.deliver",
          "$JS.API.DIRECT.GET.KV_mash-directory.\u003e",
          "$JS.API.DIRECT.GET.KV_mash-leases.$KV.mash-leases.{{name()}}",
          "$JS.API.DIRECT.GET.inbox-{{name()}}",
          "$JS.API.DIRECT.GET.inbox-{{name()}}.\u003e",
          "$JS.API.INFO",
          "$JS.API.STREAM.INFO.KV_mash-directory",
          "$JS.API.STREAM.INFO.KV_mash-leases",
          "$JS.API.STREAM.INFO.inbox-{{name()}}",
          "$KV.mash-leases.{{name()}}",
          "$SRV.\u003e",
          "_INBOX.\u003e",
          "agents.hb.cc.acme.{{name()}}",
          "agents.mail.*.acme.internal.*",
          "agents.mail.*.acme.{{tag(allow)}}",
          "agents.prompt.*.acme.*",
          "agents.status.*.acme.*"
        ],
        "pub_deny": [
          "agents.mail.*.acme.{{tag(deny)}}"
        ],
        "sub": [
          "$SRV.\u003e",
          "_INBOX.{{name()}}.\u003e",
          "agents.hb.*.acme.*",
          "agents.prompt.cc.acme.{{name()}}",
          "agents.status.cc.acme.{{name()}}"
        ]
      }
    }
  },
  "tags": {
    "billing-agent": [
      "deny:_none",
      "deny:internal.hr-agent"
    ],
    "build-bot": [
      "deny:_none",
      "deny:internal.hr-agent"
    ],
    "deploy-tool": [
      "deny:_none",
      "deny:internal.hr-agent"
    ],
    "hr-agent": [
      "deny:_none",
      "deny:internal.hr-agent"
    ],
    "ledger-agent": [
      "deny:_none",
      "deny:internal.hr-agent"
    ],
    "support-bot": [
      "allow:dmz.web-intake",
      "deny:_none",
      "deny:internal.hr-agent"
    ],
    "web-intake": [
      "allow:internal.support-bot",
      "deny:_none"
    ]
  }
}
