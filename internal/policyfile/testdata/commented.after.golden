# Our policy. Edited by hand and by mashctl.
default: deny   # closed unless a rule opens it

endpoints:
  # the front desk
  web-intake:
    labels: {net: dmz}

  support-bot:
    labels:
      team: helpdesk   # who answers
      tier: "1"

  billing-agent:   # no labels yet
    labels: {net: internal}
  # the tools
  deploy-bot: {labels: {net: internal, kind: tool}}
  ledger:
    labels: {net: internal, team: finance}

# rules follow

rules:
  - name: dmz-talks
    action: allow
    from: {net: dmz}
    to: {net: dmz}

tests:
  - {from: web-intake, to: support-bot, expect: allow}
