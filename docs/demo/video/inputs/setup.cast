[192.132142, "o", "\u001b[?25l\u001b[H\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m●\u001b[3G\u001b[39mDemo setup, personal account with the wake flag, no \u001b[38;5;153mgh\u001b[39m. I'll start with step 2 and download \u001b[38;5;153mnats-server\u001b[107G\u001b[39mand\r\u001b[2C\u001b[1B\u001b[38;5;153mnats\u001b[39m, each checked against\u001b[30Gits\u001b[34G\u001b[38;5;153mSHA256SUMS\u001b[39m.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mRan \u001b[1m2\u001b[9G\u001b[22mshell commands \u001b[39m\u001b[K\r\u001b[2C\u001b[2BBoth\u001b[8Gchecksums matched. Step\u001b[32G3 is\u001b[37Gnext: I'll downl\u001b[54Gad the two sc\u001b[68Gipts and check them against the release\u001b[K\r\u001b[2C\u001b[1Bchecksums.\u001b[14G\u001b[K\r\u001b[6C\u001b[2B\u001b[38;5;246m\u001b[1m1\u001b[22G\u001b[22m \u001b[39m\u001b[K\r\u001b[2C\u001b[2BThe rel\u001b[11Gase tag is v0.5.6 and both checksums\u001b[48Gmatched.\u001b[57GBefore I run either\u001b[77Gscript I'll show \u001b[95Ghem to you,\u001b[K\r\u001b[2C\u001b[1Bstarting with\u001b[17G\u001b[38;5;153minstall.sh\u001b[39m.\r\u001b[3C\u001b[2B\u001b[38;5;246mead \u001b[1m2\u001b[22m fi\u001b[13Ges \u001b[39m\u001b[K\r\u001b[2C\u001b[2BBoth scripts match\u001b[22Gtheir hea\u001b[32Gers: install.sh\u001b[48Gfe\u001b[54Gs and ch\u001b[63Gcks mash and mashctl\u001b[84Ginto\u001b[89G~/.local/bin\u001b[102Gwithout\r\u001b[3C\u001b[1Budo, and the\u001b[17GNATS setup script\u001b[35Gbuilds\u001b[42Ga\u001b[44Gprivate\u001b[52GCA\u001b[55Gand\u001b[59Ga\u001b[61Glocalhost\u001b[71GTLS\u001b[75Gserver\u001b[82Gin\u001b[85G~/mash-nats\u001b[97Gwhile\u001b[103Grefusing\r\u001b[2C\u001b[1Broot.\u001b[9GI'm\u001b[13Grunning\u001b[21Gboth\u001b[26Gnow.\u001b[38;5;246m · summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1C\u001b[1B Running \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[18C\u001b[2B\u001b[38;5;246m4\u001b[40Gthought for 2s)\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
