\"$HOME/.local/bin\"; DL=\"$HOME/mash-setup-dl\"; TAG=v0.5.6\r\u001b[5C\u001b[1BMASH_INSTALL_DIR=\"$BIN\" MASH_VERSION=\"$TAG\" bash \"$DL/install.sh\" && PATH=\"$BIN:$PATH\" bash \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;246m\"$DL/mash-local-nats-setup.sh\" --dir \"$HOME/mash-nats\" --owner acme\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
