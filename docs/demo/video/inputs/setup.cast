[87.292448, "o", "\u001b[?25l\u001b[H\r\u001b[1B  Fable 5.2 is here for your longest\u001b[38Gand\u001b[42Gtoughest\u001b[51Gcoding\u001b[58Gtasks.\u001b[65GIt\u001b[68Gdraws\u001b[74Gdown\u001b[79Gusage\u001b[85Gfaster\u001b[92Gthan\u001b[97GOpus\u001b[102G5.5.\r\u001b[1B  Switch with \u001b[38;5;153m/model\u001b[39m.\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[48;5;237m\u001b[38;5;246m❯ \u001b[38;5;231mSet mash up on this machine, with two agents: acme.demo.alice and acme.demo.bob.\u001b[39m                            \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;114m●\u001b[3G\u001b[39m\u001b[1mSkill\u001b[22m(mash-setup:setup)\r\u001b[1B\u001b[38;5;246m  ⎿  \u001b[39mLoaded\u001b[13Gskill\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m●\u001b[3G\u001b[39mI'll\u001b[8Gstart\u001b[14Gwith\u001b[19Gthe\u001b[23Gread-only\u001b[33Glook\u001b[38Gat\u001b[41Gthe\u001b[45Gmachine.\u001b[54GIt\u001b[57Gchanges\u001b[65Gnothing.\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;5;246mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[2B\u001b[39mNothing is\u001b[14Ginstall\u001b[22Gd yet \u001b[30G this Ubuntu x86_64 machine, \u001b[61Gd \u001b[38;5;153mgh\u001b[39m is missing,\u001b[78Gso\u001b[81GI\u001b[83Gcan't\u001b[89Gverify\u001b[96Gthe\u001b[100Grelease's\r\u001b[2C\u001b[1Bsigned\u001b[10Gattestation.\u001b[23GI\u001b[25Gneed\u001b[30Gthree\u001b[36Ganswers\u001b[44Gfrom\u001b[49Gyou\u001b[53Gbefore\u001b[60GI\u001b[62Gchange\u001b[69Ganything.\u001b[38;5;246m · summary\r\u001b[1B──────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B← \u001b[48;5;153m\u001b[38;5;16m ☐ Setup mode \u001b[18G\u001b[39m\u001b[49m☐\u001b[20GAccount\u001b[29G☐\u001b[31GNo\u001b[34Ggh\u001b[38G✔\u001b[40GSubmit\u001b[48G→\r\u001b[1B\u001b[K\r\u001b[1B\u001b[2m│\u001b[3G\u001b[22m\u001b[38;5;231m\u001b[1mWhich setup do you want? Demo uses every default (folders ~/.local/bin, ~/mash-nats, ~/mash-setup-dl) and \r\u001b[1B\u001b[22m\u001b[39m\u001b[2m│\u001b[3G\u001b[22m\u001b[38;5;231m\u001b[1mone yes covers steps 2 to 8. General asks for a yes before each step.\r\u001b[2B\u001b[22m\u001b[38;5;153m❯\u001b[3G\u001b[38;5;246m1.\u001b[6G\u001b[38;5;153mDemo (Recommended)\r\u001b[5C\u001b[1B\u001b[38;5;246mOne yes, then I run all steps with the defaults and the names you gave.\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[39mGeneral\r\u001b[1B \u001b[3G   \u001b[38;5;246mI ask for a separate yes\u001b[31Gbefore each step, and you can change the folders.\r\u001b[2C\u001b[1B3. Type something.\r\u001b[1B──────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[39m  4.\u001b[6GChat\u001b[11Gabout\u001b[17Gthis\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246mEnter to select ·\u001b[19GTab/Arrow keys to navigate\u001b[46G· Esc to cancel\u001b[39m\u001b[30;1H\u001b[22;1H"]
