#!/usr/bin/env bash
# ci-changes: does this change need the full CI job set? Prints "code=true" or "code=false" on stdout (the changes
# jobs of ci.yml, lint.yml and security.yml append it to $GITHUB_OUTPUT). The changed paths are read from stdin, one per
# line, as `git diff --no-renames --name-only` prints them (a rename lists both paths).
#
# Environment:
#   EVENT     the workflow's github.event_name
#   HEAD_REF  the pull request's head ref (github.head_ref; empty on other events)
#
# code=false only for a pull request, a Mergify merge-queue draft or a push to main whose changed paths are nothing but
# documentation: every path is under docs/ or is a *.md file AND is not one a build, a test or the release tooling reads.
# The caller passes the paths the event adds: a pull request's diff against its base; a queue draft's diff against main is
# the whole batch (so a docs-only batch is docs-only and a batch with one code pull request is code); a push's diff is
# the range it added (the release gate walks back past docs-only heads to the newest commit whose tests ran, ADR 0156 and
# internal/release/checks.go). Everything else is code:
#   - a merge group, a schedule or any other event;
#   - an empty path list (nothing to compare);
#   - any path not listed as documentation below (the default is code, so a new top-level path is code).
# Agent instructions stay code too: everything under mash-setup/ (the setup skills) and AGENTS.md or CLAUDE.md anywhere.
# Documentation that a test or the build reads stays code, so it is tested when it changes:
# docs/branch-protection.md (internal/release), docs/reference/ and spec/ (internal/refgen compares the generated reference with the spec), docs/review/ (scripts/reviewgate and scripts/gate read policy.json), docs/allowed_signers, docs/skipped-releases.txt and docs/release-cutover (the release tooling), CHANGELOG.md and changelog.d/
# (scripts/changelog, lint.yml), every *.md under .github/, plugin/, scripts/, cmd/, internal/ and ci/ (the plugin package is
# embedded; the rest sit beside code), test data, Go and module files, and binary assets under docs/ (internal/release
# refuses a committed binary). docs/decisions/ is documentation: adr-lint and adr-numbers run on every pull request anyway.
set -euo pipefail

# is_docs succeeds for a path that is documentation no test or build reads.
is_docs() {
	local p="$1" lower
	lower="$(printf '%s' "$p" | tr '[:upper:]' '[:lower:]')"
	case "$p" in
	.github/* | .mergify.yml | .claude-plugin/* | plugin/* | scripts/* | cmd/* | internal/* | ci/*) return 1 ;;
	# Agent instructions: a skill or a briefing an agent executes is code in effect (mash-lead, ADR 0156), wherever it sits.
	mash-setup/* | AGENTS.md | */AGENTS.md | CLAUDE.md | */CLAUDE.md) return 1 ;;
	go.mod | go.sum | */go.mod | */go.sum | *.go) return 1 ;;
	testdata/* | */testdata/* | *conformance*) return 1 ;;
	CHANGELOG.md | changelog.d/*) return 1 ;;
	docs/branch-protection.md | docs/review/* | docs/reference/* | spec/* | docs/allowed_signers | docs/skipped-releases.txt | docs/release-cutover) return 1 ;;
	esac
	# Agent instructions, wherever they sit and in any letter case (x-lead, ADR 0156): the named files, any *.tmpl, any path with
	# a directory component named like the places agents read instructions, and mash-setup/ at any depth. README.md, docs/install.md,
	# SECURITY.md and CONTRIBUTING.md stay docs.
	local base="${lower##*/}" dirs c
	case "$base" in
	agents.md | claude.md | gemini.md | skill.md | .cursorrules | .windsurfrules | *.tmpl) return 1 ;;
	esac
	case "$lower" in mash-setup/* | */mash-setup/*) return 1 ;; esac
	if [ "$lower" != "$base" ]; then
		dirs="${lower%/*}"
		local IFS=/
		for c in $dirs; do
			case "$c" in
			skills | commands | agents | hooks | prompts | briefings | plugins | .claude-plugin) return 1 ;;
			esac
		done
	fi
	case "$lower" in
	docs/*.png | docs/*.jpg | docs/*.jpeg | docs/*.gif | docs/*.ico | docs/*.pdf | docs/*.woff | docs/*.woff2) return 1 ;;
	esac
	case "$p" in
	docs/* | *.md) return 0 ;;
	esac
	return 1
}

files="$(cat)"
code=true
case "${EVENT:-}" in
pull_request | push)
	if [ -n "$files" ]; then
		code=false
		while IFS= read -r f; do
			if ! is_docs "$f"; then
				code=true
				break
			fi
		done <<<"$files"
	fi
	;;
esac
echo "code=$code"
