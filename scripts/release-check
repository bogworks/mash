#!/bin/sh
# The release gate. Usage: scripts/release-check <X> <version>  |  scripts/release-check --assets <version> <X>
# The command is built first and run directly, so its exit code (2 usage, 3 refused, 4 could not decide) reaches the caller.
set -eu
root="$(cd "$(dirname "$0")/.." && pwd)"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
cd "$root"
# Bootstrap under the pinned Go settings too: an ambient workspace, overlay or experiment must not change the gate.
GOWORK=off GOENV=off GOFLAGS= GOEXPERIMENT= GOTOOLCHAIN=go1.27.3 CGO_ENABLED=0 go build -o "$tmp/release-check" ./scripts/releasecheck
"$tmp/release-check" "$@"
